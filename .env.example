# Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Playwright MCP Configuration
PLAYWRIGHT_MCP_URL=http://localhost:8080

# Temporary test-failure injection for healing validation
# Set to true to intentionally break the generated login selector and verify:
# Executor failure -> Healer/Gemini -> test fix -> Executor retry -> pass
INTENTIONAL_TEST_FAILURE=false

# Application Configuration
APP_URL=https://www.saucedemo.com
DEFAULT_USERNAME=standard_user
DEFAULT_PASSWORD=secret_sauce

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Playwright MCP Configuration
PLAYWRIGHT_MCP_URL=http://localhost:8080

# Reproducible, scenario-relevant failure injection for recovery validation.
# The Orchestrator selects Explorer, Planner, Generator, or Executor-layer failures.
INTENTIONAL_TEST_FAILURE=false

# Application Configuration
APP_URL=https://www.saucedemo.com
DEFAULT_USERNAME=standard_user
DEFAULT_PASSWORD=secret_sauce

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs
